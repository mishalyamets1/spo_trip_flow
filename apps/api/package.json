{
  "name": "@tripflow/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test ../../tests/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include='**/apps/api/src/services/*.ts' --test-coverage-include='**/apps/api/src/repositories/*.ts' --test-coverage-exclude='**/demo.*' --test-coverage-include='**/apps/api/src/validators/*.ts' ../../tests/*.test.ts",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6"
  }
}
